<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bouton « Libérer la mémoire » : arrêter les processus d'arrière-plan des autres applications
         (MemoryCleaner), qui doivent donc être visibles (celles qu'on peut lancer). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RomCloudNative">

        <!-- Modes de jeu du système (performance, économie) : voir res/xml/game_mode_config.xml. -->
        <meta-data
            android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Le jeu tourne dans un processus à part : un plantage du code traduit ne ferme que lui,
             et quitter l'écran arrête le jeu en tuant ce processus. -->
        <activity
            android:name=".PortActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="false"
            android:process=":port" />
    </application>
</manifest>
