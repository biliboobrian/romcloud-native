    <string name="settings_unity_single_thread_help">Can help games that stutter or crash in rendering.</string>
    <string name="settings_unity_quality">Quality level</string>
    <string name="settings_unity_quality_help">One of the game\'s quality levels (shadows, effects, anti-aliasing). Low: much less work for the GPU.</string>
    <string name="settings_unity_cpu_skinning">Character animation on the CPU</string>
    <string name="settings_unity_cpu_skinning_help">Relieves the GPU when it is the bottleneck and the CPU has headroom.</string>
    <string name="settings_unity_gfx_thread">Separate render thread</string>
    <string name="settings_unity_gfx_thread_help">Draw calls are sent from a second core: faster when the main thread is busy (Castlevania).</string>
    <string name="settings_unity_no_log">No log file</string>
